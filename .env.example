# ApiCoreX Core — example environment.
# Copy to .env and fill in real values. Never commit .env (it is gitignored).

# ── Required ───────────────────────────────────────────────────────────────
# Shared key plugins present when they register with Core. Also authenticates
# Core to Identity's internal /internal/introspect endpoint, which Core calls
# on every request to resolve the opaque device token in the Authorization
# header — Core never parses or stores tokens itself. Must match the Identity
# plugin's PLUGIN_API_KEY.
PLUGIN_API_KEY=change-me-plugin-key

# ── Server ─────────────────────────────────────────────────────────────────
HTTP_PORT=:8080

# ── Optional: plugin security ──────────────────────────────────────────────
# Comma-separated plugin names allowed to register. Empty = allow any (dev only).
# PLUGIN_ALLOWLIST=identity,billing

# ── Optional: gateway dashboard login ──────────────────────────────────────
# Single shared secret key to log into the embedded dashboard at /dashboard
# (not a username/password pair). Empty = login disabled (dev only) — anyone
# reaching /dashboard sees it with no key prompt.
# DASHBOARD_SECRET=change-me-dashboard-key

# ── Optional: distributed tracing ──────────────────────────────────────────
# OTLP endpoint (e.g. Jaeger/Tempo). If unset, tracing is a no-op.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Optional: CORS ──────────────────────────────────────────────────────────
# Comma-separated origins allowed to call Core from a browser. Empty = no
# restriction (dev only).
# CORS_ALLOWED_ORIGINS=https://app.yourcompany.com

# ── Optional: where the published port is bound ────────────────────────────
# Default 0.0.0.0 — Core answers on every interface, including the public IP,
# over plain HTTP. Behind a TLS-terminating proxy that is a way around the
# proxy, so it is worth closing.
#
# Not by setting this to 127.0.0.1, though, unless the plugins share a docker
# network with Core: they reach it at host.docker.internal, which is the bridge
# gateway rather than loopback, and a loopback-bound socket refuses that — every
# plugin would fail to register. Until then, block the port at the host
# firewall.
# CORE_BIND=127.0.0.1

# ── Optional: browser-facing deployment ────────────────────────────────────
# Where a browser with no session is sent. A path on this origin, not a URL —
# Core redirecting to another host is something a crafted link could abuse.
# Empty leaves every unauthenticated request with the JSON 401 an API client
# expects, which is not what a person navigating to a page should see.
# LOGIN_URL=/login

# Hostnames that stand for one plugin's surface: a path nothing else serves
# gets that plugin's prefix put back before routing, so panel.example.com/students
# reaches <gateway>/school/students and the panel renders links with no prefix.
# The suite's shared paths (/login, /accounting, /_core) still work there,
# because only a path no plugin already claims is rewritten.
#
# Requires the reverse proxy to preserve the Host header — see
# Caddyfile.example, and docs/panel-domain-plan.md §6.1 in schoolyze-server for
# the nginx equivalent. A malformed entry stops Core from starting rather than
# being skipped, because a skipped mapping is a hostname that 404s silently.
# PRODUCT_HOSTS=panel.example.com=/school,gl.example.com=/accounting

# ── Optional: protection limits ────────────────────────────────────────────
# Per-plugin overrides (including the per-tenant rate sub-limit —
# tenant_rate_per_sec/tenant_rate_burst — which has no env-var form) go in a
# YAML file (see config.example.yaml).
# CONFIG_FILE=./config.yaml
# These env vars override the global default instead:
# RATE_PER_SEC=1000
# BULKHEAD_MAX=100
# CB_THRESHOLD=5
# CB_RESET_TIMEOUT=30s
# REQUEST_TIMEOUT=30s
# HEALTH_INTERVAL=30s
