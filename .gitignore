# Local env & secrets — never commit
.env
*.env
!.env.example

# Build artifacts
tmp/
bin/
dist/
*.exe
*.out

# Local config override (commit only .example)
config.yaml

# OS / editor
.DS_Store
.idea/
.vscode/

# Local tooling state
.remember/
.claude/

# Local development stack env. `.env` and `*.env` above do not match
# `.env.dev` — it ends in .dev, not .env — so it needs its own line, and
# it holds a real database password.
.env.dev
!.env.dev.example
