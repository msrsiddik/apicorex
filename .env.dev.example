# Local development stack — loaded by `make dev`, never by Docker or CI.
#
# This is a SECOND, parallel stack: the deployed containers keep their ports
# (Core 9999, Identity 50051, Schoolyze 50053) and keep running. Core evicts any
# earlier registration for a plugin name, so a dev plugin pointed at the deployed
# Core would evict the deployed one and the two would fight. Hence a dev Core of
# its own, on its own port, with its own plugins.

HTTP_PORT=:19999

# Shared with the dev Identity and dev Schoolyze — all three must match, and it
# deliberately differs from the deployed stack's key.
PLUGIN_API_KEY=

# Signs the Core dashboard session.
APICOREX_SECRET=

# Empty = accept any plugin that registers. Fine for dev, not for deployment.
PLUGIN_ALLOWLIST=

# Where a signed-out browser is sent, with ?next= to return it afterwards.
# Empty keeps the JSON 401 every unauthenticated request used to get, which is
# right for an API client and wrong for a person.
#
# Identity's, which is where the suite's one login lives: it owns
# authentication and runs in every deployment, so a deployment with no school
# still has a way for anyone to sign in.
LOGIN_URL=/login

CORS_ALLOWED_ORIGINS=
CONFIG_FILE=

# Protection limits, loosened so a debugger breakpoint does not trip the circuit
# breaker while you are sitting on it.
RATE_PER_SEC=1000
BULKHEAD_MAX=100
CB_THRESHOLD=20
CB_RESET_TIMEOUT=10s
REQUEST_TIMEOUT=300s
HEALTH_INTERVAL=30s
